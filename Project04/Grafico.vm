push constant 512
add
pop local 0
push local 1
push constant 1
add
pop local 1
goto DRAW_ROW_LOOP
label DRAW_ROW_END
push constant 0
pop local 1
label DRAW_PIXEL_LOOP
push local 1
push constant 16
lt
if-goto DRAW_PIXEL_BODY
goto DRAW_PIXEL_END
label DRAW_PIXEL_BODY
push argument 2
push local 1
add
pop pointer 1
push that 0
pop local 2
push local 0
pop pointer 1
push local 2
pop that 0
push local 0
push constant 32
add
pop local 0
push local 1
push constant 1
add
pop local 1
goto DRAW_PIXEL_LOOP
label DRAW_PIXEL_END
push constant 0
return

