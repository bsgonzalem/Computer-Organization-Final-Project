
/**
 * File: Carrera.jack
 * Description: Implements the race game logic and obstacle management.
 * Autor: Brayan
 */
class Carrera {
    field ObstacleList obstacles;
    field int currentLane;
    field int lives;
    field int score;
    field int progress;
    field int targetSteps;
    field int gameState;
    field int pendingDirection;
    field int randomState;

    // Creates a new race with its initial game state.
    constructor Carrera new(int steps, int seed) {
        let obstacles = ObstacleList.new();
        let currentLane = 1;
        let lives = 3;
        let score = 0;
        let progress = 0;
        let targetSteps = steps;
        let gameState = 0;
        let pendingDirection = 0;
        let randomState = seed;
        return this;
    }

    // Releases the race and all its active obstacles.
    method void dispose() {
        do obstacles.dispose();
        do Memory.deAlloc(this);
        return;
    }

    // Stores a valid lane change for the next game step.
    method void moverCarro(int direction) {
        if (gameState = 0) {
            if ((direction = -1) | (direction = 1)) {
                let pendingDirection = direction;
            }
        }
        return;
    }

    // Adds an obstacle when its parameters and capacity are valid.
    method void agregarObstaculo(int type, int lane, int col) {
        var Obstacle newObstacle;
        if (gameState = 0) {
            if ((type < 0) | (type > 3)) {
                return;
            }
            if ((lane < 0) | (lane > 2)) {
                return;
            }
            if ((col < 0) | (col > 31)) {
                return;
            }
            if (obstacles.getSize() < 20) {
                let newObstacle = Obstacle.new(type, lane, col);
                do obstacles.add(newObstacle);
            }
        }
        return;
    }

    // Returns the obstacle type occupying a cell, or -1 if empty.
    method int ocupada(int lane, int col) {
        var ObstacleNode current;
        var Obstacle item;
        var int itemLane, itemCol, itemLength;

        if ((lane < 0) | (lane > 2)) {
            return -1;
        }
        if ((col < 0) | (col > 31)) {
            return -1;
        }
        let current = obstacles.getHead();
        while (~(current = null)) {
            let item = current.getObstacle();
            let itemLane = item.getLane();
            let itemCol = item.getColumn();
            let itemLength = item.getLength();
            if (itemLane = lane) {
                if ((~(col < itemCol)) & (col < (itemCol + itemLength))) {
                    return item.getType();
                }
            }
            let current = current.getNext();
        }
        return -1;
    }

    // Applies the pending lane change if the destination is valid.
    method void applyDirection() {
        var int newLane;
        let newLane = currentLane + pendingDirection;
        if ((~(newLane < 0)) & (newLane < 3)) {
            let currentLane = newLane;
        }
        let pendingDirection = 0;
        return;
    }

    // Moves every active obstacle according to its speed.
    method void moveObstacles() {
        var ObstacleNode current;
        var Obstacle item;
        let current = obstacles.getHead();
        while (~(current = null)) {
            let item = current.getObstacle();
            do item.move();
            let current = current.getNext();
        }
        return;
    }

    // Checks collisions and removes obstacles that touch the car.
    method void checkCollisions() {
        var ObstacleNode current, nextNode;
        var Obstacle item;
        var int itemLane, oldCol, newCol, itemLength, itemType;

        let current = obstacles.getHead();
        while (~(current = null)) {
            let nextNode = current.getNext();
            let item = current.getObstacle();
            let itemLane = item.getLane();
            let oldCol = item.getPreviousColumn();
            let newCol = item.getColumn();
            let itemLength = item.getLength();
            let itemType = item.getType();

            if (itemLane = currentLane) {
                if ((newCol < 3) & (~((oldCol + itemLength - 1) < 2))) {
                    if (itemType = 3) {
                        let score = score + 10;
                    } else {
                        let lives = lives - 1;
                    }
                    do obstacles.remove(current);
                }
            }
            if (lives = 0) {
                let gameState = 1;
                return;
            }
            let current = nextNode;
        }
        return;
    }

    // Removes obstacles that have completely left the screen.
    method void removeExited() {
        var ObstacleNode current, nextNode;
        var Obstacle item;
        var int col, length;
        let current = obstacles.getHead();
        while (~(current = null)) {
            let nextNode = current.getNext();
            let item = current.getObstacle();
            let col = item.getColumn();
            let length = item.getLength();
            if ((col + length - 1) < 0) {
                do obstacles.remove(current);
            }
            let current = nextNode;
        }
        return;
    }

    // Executes one complete game step in the required order.
    method void avanzar() {
        if (~(gameState = 0)) {
            return;
        }
        do applyDirection();
        do moveObstacles();
        do checkCollisions();
        if (gameState = 1) {
            return;
        }
        do removeExited();
        let progress = progress + 1;
        let score = score + 1;
        if (progress = targetSteps) {
            let gameState = 2;
        }
        return;
    }

    // Updates the internal pseudo-random generator.
    method int nextRandom() {
    var int oldState;
    let oldState = randomState;
    let randomState = oldState + oldState + oldState + oldState + oldState + 3;
    return randomState;

    }   

    // Returns the non-negative remainder of a value divided by a divisor.
    method int positiveMod(int value, int divisor) {
        while (value < 0) {
            let value = value + divisor;
        }
        while (~(value < divisor)) {
            let value = value - divisor;
        }
        return value;
    }

    // Checks whether a lane contains a lethal obstacle near the entrance.
    method boolean hasLethal(int lane) {
        var int col, type;
        let col = 26;
        while (col < 32) {
            let type = ocupada(lane, col);
            if ((~(type < 0)) & (type < 3)) {
                return true;
            }
            let col = col + 1;
        }
        return false;
    }

    // Generates at most one obstacle in a free entrance cell.
    method void generar() {
        var int lane, type, attempt;
        if (~(gameState = 0)) {
            return;
        }
        if (~(obstacles.getSize() < 20)) {
            return;
        }
        let lane = Math.mod(nextRandom(), 3);
        if (lane < 0) {
            let lane = lane + 3;
        }
        let attempt = 0;
        while (attempt < 3) {
            if (ocupada(lane, 31) = -1) {
                let attempt = 3;
            } else {
                let lane = Math.mod(lane + 1, 3);
                let attempt = attempt + 1;
            }
        }
        if (ocupada(lane, 31) = -1) {
            let type = Math.mod(nextRandom(), 4);
            if (type < 0) {
                let type = type + 4;
            }
            if (type < 3) {
                if (hasLethal(Math.mod(lane + 1, 3)) & hasLethal(Math.mod(lane + 2, 3))) {
                    let type = 3;
                }
            }
            do agregarObstaculo(type, lane, 31);
        }
        return;
    }

    // Returns the player's current lane.
    method int carrilCarro() {
        return currentLane;
    }

    // Returns the number of remaining lives.
    method int vidas() {
        return lives;
    }

    // Returns the current score.
    method int puntaje() {
        return score;
    }

    // Returns the number of completed steps.
    method int progreso() {
        return progress;
    }

    // Returns the current game state.
    method int estado() {
        return gameState;
    }

    // Returns the number of active obstacles.
    method int cantidad() {
        return obstacles.getSize();
    }
}
